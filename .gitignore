# Ignore large files
data/raw/
data/processed/

# Allow lightweight sample data for Streamlit Cloud
!data/processed/sample_train_features.csv
!data/processed/sample_test.csv


# Ignore heavy models, but include small demo ones
models/
!models/FD001_rf.joblib
!models/FD001_xgb.joblib
!models/FD001_lstm.h5


# Ignore virtual environment and cache
.venv/
__pycache__/

# Runtime logs and the zipped copy of archive/ (same 15 files, extracted)
app.log
*.log
archive.zip
